# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Prisma Postgres, Neon, Supabase-as-plain-Postgres, local Postgres… any PostgreSQL works.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/preppilot"
# Optional: a direct (non-pooled) URL used only by `prisma migrate` when DATABASE_URL points at a pooler.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/preppilot"

# ── Clerk (authentication) ───────────────────────────────────────────────────
# Clerk Dashboard → API keys. The publishable key is safe for the browser; the secret key is server-only.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."   # same value; read by the Express SDK (falls back to VITE_CLERK_PUBLISHABLE_KEY)
CLERK_SECRET_KEY="sk_test_..."
# Optional: Clerk Dashboard → Webhooks → endpoint https://<api-host>/api/webhooks/clerk (user.created/updated/deleted)
CLERK_WEBHOOK_SECRET=""

# ── YouTube Data API v3 (server-side only) ───────────────────────────────────
# Optional. Without it, playlist import is disabled and videos can still be added manually.
YOUTUBE_API_KEY=""

# ── API server ───────────────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated list of allowed browser origins (your deployed frontend URL in production).
CLIENT_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"

# ── Frontend ─────────────────────────────────────────────────────────────────
# Leave empty in development (Vite proxies /api). In production set to the public API URL, e.g. https://api.example.com
VITE_API_BASE_URL=""

# ── Tests (never point this at a database you care about; it must end in _test) ─
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/preppilot_test"
